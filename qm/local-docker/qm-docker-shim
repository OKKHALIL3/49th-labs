#!/bin/sh
# Workaround for QM core images where QM_CORE_CONTAINER is not passed to the local sandbox
# (core then dials 127.0.0.1:<published port>, which inside the core container is core itself).
# `docker port <sandbox> 8080/tcp` is answered with a local forwarder port that proxies over the
# sandbox's private network to <sandbox>:8080. Every other docker call passes through unchanged.
REAL=/usr/bin/docker
SHIM_DIR="$(dirname "$0")"
if [ "$1" = "port" ] && [ -n "$2" ]; then
  name="$2"
  core="${QM_CORE_CONTAINER:-qm-acme-rev-core}"
  for net in $($REAL inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$name" 2>/dev/null); do
    $REAL network connect "$net" "$core" >/dev/null 2>&1 || true
  done
  port=$(node -e 'let h=0;for(const c of process.argv[1])h=(h*31+c.charCodeAt(0))>>>0;console.log(20000+h%20000)' "$name")
  if ! node -e 'const s=require("net").connect(+process.argv[1],"127.0.0.1");s.on("connect",()=>process.exit(0));s.on("error",()=>process.exit(1))' "$port"; then
    nohup node "$SHIM_DIR/fwd.js" "$port" "$name" 8080 </dev/null >>"$SHIM_DIR/fwd.log" 2>&1 &
    i=0; while [ $i -lt 20 ]; do
      node -e 'const s=require("net").connect(+process.argv[1],"127.0.0.1");s.on("connect",()=>process.exit(0));s.on("error",()=>process.exit(1))' "$port" && break
      i=$((i+1)); sleep 0.2
    done
  fi
  echo "127.0.0.1:$port"
  exit 0
fi
exec $REAL "$@"
